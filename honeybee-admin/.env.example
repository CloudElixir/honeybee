## HoneyBee Trips Admin (.env)
## Copy this file to `.env` and fill values.
## Do NOT commit `.env` (it is ignored by `.gitignore`).

# MySQL connection (Hostinger)
HB_DB_HOST=localhost
HB_DB_PORT=3306
HB_DB_NAME=u625306522_honeybee
HB_DB_USER=u625306522_honeybeeuser
HB_DB_PASS=REPLACE_WITH_YOUR_PASSWORD

# Admin base URL (where THIS PHP app is hosted — System Health pings api/public.php here).
# HB_APP_BASE_URL=https://YOUR-BACKEND-HOST.hostingersite.com

# If hosted under a subfolder (e.g. /honeybee_admin), set it; otherwise leave blank
HB_APP_BASE_PATH=

# Comma-separated frontend origins for CORS (must include your static React site)
HB_APP_CORS_ORIGINS=https://slategrey-hamster-219402.hostingersite.com

