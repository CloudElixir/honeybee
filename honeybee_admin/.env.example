# HoneyBee admin (`honeybee_admin/`) — copy to `.env` on the server. Never commit real secrets.

# --- Database (Hostinger MySQL) ---
HB_DB_HOST=localhost
HB_DB_PORT=3306
HB_DB_NAME=your_database
HB_DB_USER=your_user
HB_DB_PASS=your_password

# --- URLs ---
# Base URL of THIS PHP deployment (where /admin and /api/public.php live). Used by System Health to ping the public API.
HB_APP_BASE_URL=https://salmon-mole-607064.hostingersite.com

# Comma-separated browser origins allowed to call the public API (CORS). Must include your static frontend hostname(s).
# Example: live site + optional local Vite dev
HB_APP_CORS_ORIGINS=https://slategrey-hamster-219402.hostingersite.com,http://localhost:5173

# If admin lives in a subfolder, e.g. /honeybee_admin (usually leave empty when docroot is honeybee_admin)
# HB_APP_BASE_PATH=

# Optional: log public API requests when debugging (writes storage/api.log)
# HB_API_DEBUG=1
