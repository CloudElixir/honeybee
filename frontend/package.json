{
  "name": "honeybee-trips",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:vite": "node ./node_modules/vite/bin/vite.js",
    "dev:admin-api": "php -S 127.0.0.1:8000 -t ../honeybee_admin",
    "dev": "concurrently -n admin,vite -c magenta,cyan \"npm run dev:admin-api\" \"npm run dev:vite\"",
    "dev:reset": "rm -rf node_modules/.vite && npm run dev",
    "dev:vite:force": "node ./node_modules/vite/bin/vite.js --force",
    "build": "node ./node_modules/vite/bin/vite.js build && npm run sitemap",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "vite-plugin-prerender": "^1.0.8",
    "concurrently": "^9.1.2"
  }
}
